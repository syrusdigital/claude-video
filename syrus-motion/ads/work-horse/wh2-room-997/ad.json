{
 "title": "Work Horse | Rooms | $997 Flat | Script 4",
 "source": "Notion: Script 4 — Most painters charge $2,000+ a room — Work Horse (Approved, $48.31 CPL). Seasonal wording removed (\"this winter\", \"Winter\").",
 "vo": {
  "voice": "am_michael",
  "speed": 1.12,
  "lines": [
   {
    "id": "hook",
    "text": "Most painters charge two thousand dollars or more to paint a room. We're doing it for nine hundred ninety-seven dollars flat, guaranteed.",
    "after": 0.35
   },
   {
    "id": "b1",
    "text": "At Work Horse Pro Painting, we believe homeowners deserve fair pricing without cutting corners.",
    "after": 0.25
   },
   {
    "id": "b2",
    "text": "That's why you can get your entire standard room professionally painted for just nine hundred ninety-seven dollars, and everything's included.",
    "after": 0.3
   },
   {
    "id": "b3",
    "text": "You'll get walls in the color you choose. Ceilings in clean, stock white flat paint. Trim in durable semi-gloss white. Standard prep work, high-quality paint, and professional labor, all included.",
    "after": 0.3
   },
   {
    "id": "b4",
    "text": "No fine print. No hidden upsells. No extra fees for the things that should already be included.",
    "after": 0.3
   },
   {
    "id": "b5",
    "text": "Just clean, professional work done right the first time, by a family-owned team with thirty years of experience serving New Hampshire, Massachusetts, and Maine.",
    "after": 0.25
   },
   {
    "id": "b6",
    "text": "This is a real offer, not a sale. Just honest value from a company whose motto says it all. Let our family treat you like family.",
    "after": 0.3
   },
   {
    "id": "cta",
    "text": "Tap Get Quote to schedule your nine hundred ninety-seven dollar room painting special, before our calendar fills up.",
    "after": 0.1
   }
  ]
 },
