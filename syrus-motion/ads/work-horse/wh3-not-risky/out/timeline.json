 "lines": [
  {
   "id": "hook",
   "text": "Hiring a painting contractor should not feel risky. But for most homeowners, it does.",
   "t0": 0.15,
   "t1": 5.113
  },
  {
   "id": "b1",
   "text": "You are letting a crew work on your home's exterior for days. And most homeowners worry about the same things.",
   "t0": 5.513,
   "t1": 11.493
  },
  {
   "id": "b2",
   "text": "Will they show up on time? Will they prep properly? Will they cut corners? Will the paint last?",
   "t0": 11.793,
   "t1": 16.985
  },
  {
   "id": "b3",
   "text": "At Work Horse Pro Painting, our process is built to remove that uncertainty.",
   "t0": 17.334,
   "t1": 21.923
  },
  {
   "id": "b4",
   "text": "From the start, everything is clearly included. The prep, the paint, the labor, and even a full pressure wash.",
   "t0": 22.173,
   "t1": 28.364
  },
  {
   "id": "b5",
   "text": "You're working with a professional crew that communicates with you, shows up on time, and does the job the right way.",
   "t0": 28.664,
   "t1": 35.273
  },
  {
   "id": "b6",
   "text": "This is how painting should be done. Simple. Predictable. And done right the first time.",
   "t0": 35.573,
   "t1": 40.548
  },
  {
   "id": "cta",
   "text": "Click Get Quote to get a free, no-pressure exterior painting estimate you can actually trust.",
   "t0": 40.848,
   "t1": 46.161
  }
 ]
