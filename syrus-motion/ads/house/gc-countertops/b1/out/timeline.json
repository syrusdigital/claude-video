 "lines": [
  {
   "id": "hook",
   "text": "Get brand-new kitchen countertops starting at just $30 per square foot.",
   "t0": 0.0,
   "t1": 4.1
  },
  {
   "id": "b1",
   "text": "Georgia homeowners love this because it finally gives you a simple, honest way to price your countertops.",
   "t0": 4.32,
   "t1": 9.46
  },
  {
   "id": "b2",
   "text": "You don't have to guess, and we don't give you inflated quotes.",
   "t0": 9.74,
   "t1": 12.22
  },
  {
   "id": "b3",
   "text": "At GC Countertops, we give you a clear price per square foot, so you know what your new countertops will cost before the job even starts.",
   "t0": 12.56,
   "t1": 19.34
  },
  {
   "id": "b4",
   "text": "Granite starts at just $30 per square foot.",
   "t0": 19.7,
   "t1": 22.2
  },
  {
   "id": "b5",
   "text": "Quartz starts at $55 per square foot.",
   "t0": 22.54,
   "t1": 24.7
  },
  {
   "id": "b6",
   "text": "And marble starts at $65 per square foot.",
   "t0": 24.9,
   "t1": 27.42
  },
  {
   "id": "b7",
   "text": "Your final price just depends on the size of your kitchen and the material you pick.",
   "t0": 27.56,
   "t1": 31.08
  },
  {
   "id": "b8",
   "text": "And we handle everything from start to finish.",
   "t0": 31.32,
   "t1": 33.64
  },
  {
   "id": "b9",
   "text": "We take out your old countertops and install your new ones, with all the labor included.",
   "t0": 34.0,
   "t1": 37.72
  },
  {
   "id": "b10",
   "text": "We've been installing countertops across Georgia for over 10 years, and we're fully licensed and insured.",
   "t0": 38.04,
   "t1": 42.9
  },
  {
   "id": "cta",
   "text": "Tap \"Get Quote\" to book your free in-home measurement and estimate.",
   "t0": 43.38,
   "t1": 46.22
  }
 ]
