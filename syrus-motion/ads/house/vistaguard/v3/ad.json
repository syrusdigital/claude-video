{
 "title": "Vistaguard V3 house",
 "vo": {
  "lines": [
   {
    "id": "hook",
    "text": "Why pay twenty thousand dollars or more for impact windows, when you can get the exact same protection for two to three times less?",
    "after": 0.05
   },
   {
    "id": "b1",
    "text": "At VistaGuard, we've helped thousands of South Florida homeowners protect their families and their homes with hurricane rated impact windows and doors.",
    "after": 0.05
   },
   {
    "id": "b2",
    "text": "The reason we can do it for so much less is simple.",
    "after": 0.05
   },
   {
    "id": "b3",
    "text": "We source our windows directly from the manufacturer, and our own crew installs them, so there's no broker adding a markup and no outside installer charging you for labor.",
    "after": 0.05
   },
   {
    "id": "b4",
    "text": "Your installation is included, free.",
    "after": 0.05
   },
   {
    "id": "b5",
    "text": "From start to finish, we handle everything, on time, on budget, and without the stress.",
    "after": 0.05
   },
   {
    "id": "b6",
    "text": "We prep properly, we work clean, and we deliver work you can trust when the storms roll in.",
    "after": 0.05
   },
   {
    "id": "b7",
    "text": "We've been protecting homes across South Florida for over thirty years, and every window we install carries a lifetime warranty on our products and materials.",
    "after": 0.05
   },
   {
    "id": "cta",
    "text": "Click Get Quote below to book your free inspection and estimate today.",
    "after": 0.05
   }
  ],
  "engine": "elevenlabs",
  "voice": "Michael (ElevenLabs v4, Kysvuk17R9MDAP9l089v)",
  "take": "fTDG7MwpfLBmGi94qLmz",
  "tempo": 1.0
 },
