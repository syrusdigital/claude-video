 "lines": [
  {
   "id": "hook",
   "text": "A bathroom remodel done in seven days. Sounds awesome, right?",
   "t0": 0.0,
   "t1": 4.02
  },
  {
   "id": "b1",
   "text": "At Luxury Home Renovations, we are looking for 10 homes with outdated bathrooms that we can remodel at a discounted rate, in return for using the before and after videos on our website.",
   "t0": 4.26,
   "t1": 13.58
  },
  {
   "id": "b2",
   "text": "To qualify, your bathroom has to be five years or older.",
   "t0": 13.9,
   "t1": 16.86
  },
  {
   "id": "b3",
   "text": "You have to be looking for either a full bathroom remodel or a tub to shower conversion.",
   "t0": 17.06,
   "t1": 21.28
  },
  {
   "id": "b4",
   "text": "And you have to be ready to get started within the next 30 days.",
   "t0": 21.56,
   "t1": 24.94
  },
  {
   "id": "b5",
   "text": "We are only looking for 10 homeowners for this showcase, so if you think your bathroom might be a good fit...",
   "t0": 25.24,
   "t1": 30.2
  },
  {
   "id": "cta",
   "text": "Hit the \"Get Quote\" button below, answer a few short questions, and we will contact you to see if you qualify.",
